program fizzbuzz;
var i, n;
begin
    n := 15;
    i := 1;
    while i <= n do
    begin
        if i mod 15 = 0 then
            print(0)
        else if i mod 3 = 0 then
            print(-3)
        else if i mod 5 = 0 then
            print(-5)
        else
            print(i);
        i := i + 1
    end
end.
